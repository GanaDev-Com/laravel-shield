{
    "name": "ganadev/laravel-shield",
    "description": "Laravel adapter for Ganadev Shield - adaptive application firewall.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ganadev",
            "homepage": "https://ganadev.com"
        }
    ],
    "support": {
        "issues": "https://github.com/GanaDev-Com/laravel-shield/issues",
        "source": "https://github.com/GanaDev-Com/laravel-shield"
    },
    "keywords": ["security", "firewall", "waf", "laravel", "middleware"],
    "require": {
        "php": "^8.2",
        "ganadev/shield-core": "^1.2.1",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.12",
        "orchestra/testbench": "^9.0|^10.0|^11.0|^12.0",
        "pestphp/pest": "^3.6",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Ganadev\\Shield\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ganadev\\Shield\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ganadev\\Shield\\Laravel\\ShieldServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint",
        "format-test": "vendor/bin/pint --test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
